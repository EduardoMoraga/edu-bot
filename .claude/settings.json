{
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(gh pr merge *)",
      "Bash(gh * pr merge)",
      "Bash(gh * pr merge *)",
      "Bash(gh * milind-soni/OpenMausBot)",
      "Bash(gh * milind-soni/OpenMausBot *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf -- /)",
      "Bash(rm -rf -- / *)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~ *)",
      "Bash(rm -rf -- ~)",
      "Bash(rm -rf -- ~ *)",
      "Bash(rm -rf ~/)",
      "Bash(rm -rf ~/ *)",
      "Bash(rm -rf -- ~/)",
      "Bash(rm -rf -- ~/ *)",
      "Read(~/.ssh)",
      "Read(~/.ssh/**)",
      "Read(~/.edu)",
      "Read(~/.edu/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-gh.sh",
            "args": []
          }
        ]
      }
    ]
  }
}
